<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Spirit - AI Grading + Git Analytics</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/jsp/error.jsp</location>
    </error-page>

    <!-- UTF-8 toàn site -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.Spirit.gitanalytics.filter.CharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Multipart config for file uploads (26 MB per file, 200 MB total) -->
    <multipart-config>
        <max-file-size>26214400</max-file-size>
        <max-request-size>209715200</max-request-size>
        <file-size-threshold>1048576</file-size-threshold>
    </multipart-config>

    <!-- Auth + Role check -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.Spirit.gitanalytics.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/app/*</url-pattern>
    </filter-mapping>

    <!-- ArtifactFilter: verify SHA-256 khi teacher tải ZIP (chạy SAU AuthFilter) -->
    <filter>
        <filter-name>ArtifactFilter</filter-name>
        <filter-class>com.Spirit.gitanalytics.filter.ArtifactFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>ArtifactFilter</filter-name>
        <url-pattern>/app/artifact</url-pattern>
    </filter-mapping>

    <!-- Start background services (DeadlineScheduler) -->
    <listener>
        <listener-class>com.Spirit.gitanalytics.listener.AppContextListener</listener-class>
    </listener>
</web-app>
